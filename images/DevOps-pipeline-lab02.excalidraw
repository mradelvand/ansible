      "isDeleted": false,
      "boundElements": [],
      "updated": 1777730542198,
      "link": null,
      "locked": false,
      "text": "“group_vars stores variables that apply to groups\nof hosts. In this case, all.yml defines variables\nused across all nodes.”",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "“group_vars stores variables that apply to groups of hosts. In this case, all.yml defines variables used across all nodes.”",
      "autoResize": false,
      "lineHeight": 1.25
    },
