    {
      "id": "LMBGIrFp5emveCKClIoR-",
      "type": "text",
      "x": 675.4479166666652,
      "y": -2981.745400432901,
      "width": 616,
      "height": 455,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
